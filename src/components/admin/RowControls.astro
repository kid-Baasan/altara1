---
// Move up / move down / remove buttons for a repeater row. Hidden until the page script runs,
// because they do nothing without JavaScript.
---

<div class="js-controls flex shrink-0 gap-1" hidden>
  <button type="button" data-action="up" class="row-btn" aria-label="Move up" title="Move up">↑</button>
  <button type="button" data-action="down" class="row-btn" aria-label="Move down" title="Move down">↓</button>
  <button type="button" data-action="remove" class="row-btn !text-red-700" aria-label="Remove" title="Remove">✕</button>
</div>
