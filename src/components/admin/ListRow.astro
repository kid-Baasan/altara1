---
import RowControls from './RowControls.astro';

interface Props {
  /** Form field name, e.g. "inclusions". */
  name: string;
  value?: string;
  error?: string;
}

const { name, value = '', error } = Astro.props;
---

<div data-row class="flex items-start gap-2">
  <label class="block flex-1">
    <span class="sr-only">Item</span>
    <input name={name} type="text" maxlength="200" value={value} aria-invalid={error ? 'true' : undefined} class="field !mt-0" />
    {error && <span class="field-error">{error}</span>}
  </label>
  <RowControls />
</div>
