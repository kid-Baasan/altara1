---
// Tick / cross list icons used in highlights and included / excluded lists.
interface Props {
  kind?: 'check' | 'cross';
}
const { kind = 'check' } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
  {kind === 'check' ? <path d="M5 12l4 4L19 7"></path> : <path d="M6 6l12 12M18 6L6 18"></path>}
</svg>
