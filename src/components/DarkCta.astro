---
// "Begin Your Journey" band with WhatsApp / mail pills, shared by most pages.
interface Props {
  image: string;
  text?: string;
}

const {
  image,
  text = "Share a little about how you'd like to feel, and our team will shape a private Bhutan journey around it — no templates, no packages.",
} = Astro.props;
---

<section class="dark-cta dark-cta--photo reveal" id="enquire" style={`background-image:url('${image}');`}>
  <div class="dark-cta-inner">
    <h2>Begin Your Journey</h2>
    <p>{text}</p>
    <div class="dark-cta-ctas">
      <a href="https://wa.me/9752333456" class="contact-pill" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path
            d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 20l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
          ></path>
        </svg>
        <span>WhatsApp Us</span>
      </a>
      <a href="mailto:hello@altara.travel" class="contact-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="M3 7l9 6 9-6"></path>
        </svg>
        <span>Mail Us</span>
      </a>
    </div>
  </div>
</section>
