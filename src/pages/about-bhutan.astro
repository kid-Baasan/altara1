---
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = true;
---

<SiteLayout title="About Bhutan — Altara" description="The last Himalayan Buddhist kingdom, in brief — geography, Gross National Happiness, carbon-negative status, and the best time to visit.">
<!-- ================= HERO ================= -->
  <section class="hero hero--page hero--center"
    style="background-image:url('/assets/images/image/about.webp');background-position:center 22%;">
    <div class="hero-content">
      <h1>About Bhutan</h1>
    </div>
    <div class="hero-mist" aria-hidden="true">
      <div class="hero-mist-layer hero-mist-layer--1" style="background-image:url('/assets/images/cloud.webp');"></div>
      <div class="hero-mist-layer hero-mist-layer--2" style="background-image:url('/assets/images/cloud.webp');"></div>
    </div>
  </section>

  <!-- ================= INTRO ================= -->
  <section class="info-lead reveal">
    <div class="container">
      <span class="eyebrow eyebrow--accent">Know Before You Go</span>
      <h2>A Kingdom That Measures<br><span class="gold">Progress Differently</span></h2>
      <p>Bhutan sits landlocked in the eastern Himalayas, between India and China's Tibet
        Autonomous Region, and never opened to foreign tourism until 1974. Half a century on, it remains the only
        carbon-negative country on Earth and the only one to place happiness — not GDP — at the center of national
        policy. There is no traffic light in the entire country, no McDonald's, no billboard advertising. What there
        is instead: fortress-monasteries a thousand years old, forest covering three-quarters of the land, and a
        culture that has had the rare chance to develop entirely on its own terms.</p>
    </div>
  </section>

  <!-- ================= STORY ================= -->
  <section class="about about--feature reveal">
    <div class="container">
      <div class="about-media">
        <div class="about-media-main">
          <img src="/assets/images/image/punakha dzong1.webp" alt="Punakha Dzong at dusk, Bhutan">
          <p class="about-media-caption">Kingdom Of<br>Peaks &amp; Dzongs</p>
        </div>
        <div class="about-media-accent">
          <img src="/assets/images/image/changangkha1.webp" alt="Temple roof and blossom in Bhutan">
        </div>
      </div>
      <div class="about-copy">
        <span class="eyebrow eyebrow--accent">Geography &amp; Culture</span>
        <h2>Land of the<br><span class="gold">Thunder Dragon</span></h2>
        <p>Bhutan calls itself <em>Druk Yul</em> — Land of the Thunder Dragon — after the thunder that rolls through
          its high valleys and the dragon that appears on its flag. The terrain climbs from subtropical plains near
          the Indian border to Himalayan peaks over 7,000 meters in the north, and almost every dzongkhag (district)
          in between holds its own dialect, dress, and dzong.</p>
        <p>Vajrayana Buddhism shapes daily life here more visibly than almost anywhere else left in the world — in
          the prayer flags strung across mountain passes, the chorten at every village entrance, and the tshechu
          festivals that still draw entire communities to their district dzong each year.</p>
      </div>
    </div>
  </section>

  <!-- ================= QUICK FACTS ================= -->
  <section class="fact-section reveal">
    <div class="container">
      <div class="values-head">
        <span class="eyebrow eyebrow--accent">At A Glance</span>
        <h2>Quick <span class="gold">Facts</span></h2>
      </div>
      <div class="fact-grid">
        <div class="fact-card">
          <div class="fact-value">Thimphu</div>
          <div class="fact-label">Capital City</div>
        </div>
        <div class="fact-card">
          <div class="fact-value">~790,000</div>
          <div class="fact-label">Population</div>
        </div>
        <div class="fact-card">
          <div class="fact-value">Ngultrum (BTN)</div>
          <div class="fact-label">Currency, Pegged To The INR</div>
        </div>
        <div class="fact-card">
          <div class="fact-value">Dzongkha</div>
          <div class="fact-label">Official Language</div>
        </div>
        <div class="fact-card">
          <div class="fact-value">Constitutional<br>Monarchy</div>
          <div class="fact-label">Government</div>
        </div>
        <div class="fact-card">
          <div class="fact-value">Vajrayana<br>Buddhism</div>
          <div class="fact-label">State Religion</div>
        </div>
        <div class="fact-card">
          <div class="fact-value">BTT (UTC+6)</div>
          <div class="fact-label">Time Zone</div>
        </div>
        <div class="fact-card">
          <div class="fact-value">38,394 km²</div>
          <div class="fact-label">Land Area</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PHILOSOPHY ================= -->
  <section class="values-section reveal">
    <div class="container">
      <div class="values-head">
        <span class="eyebrow eyebrow--accent">What Sets It Apart</span>
        <h2>A Different Measure<br><span class="gold">Of Progress</span></h2>
      </div>
      <div class="value-grid">
        <div class="value-card">
          <div class="value-number">01</div>
          <h3>Gross National Happiness</h3>
          <p>Since the 1970s, Bhutan has weighed policy against four pillars — sustainable development,
            environmental conservation, cultural preservation, and good governance — rather than economic output
            alone.</p>
        </div>
        <div class="value-card">
          <div class="value-number">02</div>
          <h3>Carbon Negative By Constitution</h3>
          <p>The constitution mandates at least 60% forest cover for all time. Bhutan's forests absorb several
            times more carbon than the entire country emits, making it the world's only carbon-negative nation.</p>
        </div>
        <div class="value-card">
          <div class="value-number">03</div>
          <h3>High Value, Low Impact</h3>
          <p>Tourism is deliberately kept small and unhurried. A Sustainable Development Fee funds free healthcare,
            education, and conservation for Bhutanese citizens — every visitor contributes directly to the country
            they've come to see.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BEST TIME TO VISIT ================= -->
  <section class="fact-section fact-section--tight reveal">
    <div class="container">
      <div class="values-head">
        <span class="eyebrow eyebrow--accent">Plan Your Trip</span>
        <h2>Best Time To <span class="gold">Visit</span></h2>
      </div>
      <div class="season-grid">
        <div class="bhutan-fact-card">
          <div class="bhutan-fact-number">Mar–May</div>
          <div class="bhutan-fact-label">Spring · Rhododendrons &amp; Paro Tshechu</div>
        </div>
        <div class="bhutan-fact-card">
          <div class="bhutan-fact-number">Jun–Aug</div>
          <div class="bhutan-fact-label">Summer · Monsoon, Lush &amp; Quiet</div>
        </div>
        <div class="bhutan-fact-card">
          <div class="bhutan-fact-number">Sep–Nov</div>
          <div class="bhutan-fact-label">Autumn · Clearest Skies &amp; Thimphu Tshechu</div>
        </div>
        <div class="bhutan-fact-card">
          <div class="bhutan-fact-number">Dec–Feb</div>
          <div class="bhutan-fact-label">Winter · Crisp, Near-Empty Monasteries</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= DARK CTA ================= -->
  <section class="dark-cta dark-cta--photo reveal" id="enquire"
    style="background-image:url('/assets/images/image/dochula 2.webp');">
    <div class="dark-cta-inner">
      <h2>Begin Your <span class="gold">Journey</span></h2>
      <p>Share a little about how you'd like to feel, and our team will shape a private Bhutan journey around it — no
        templates, no packages.</p>
      <div class="dark-cta-ctas">
        <a href="https://wa.me/9752333456" class="contact-pill" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
            stroke-linejoin="round">
            <path
              d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 20l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
          <span>WhatsApp Us</span>
        </a>
        <a href="/enquire" class="contact-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12h16M14 6l6 6-6 6"></path>
          </svg>
          <span>Contact Us</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
