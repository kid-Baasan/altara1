---
// Photo gallery: a masonry grid of every visible photo, filterable by group, opening in a lightbox.
// Works without JavaScript (filters are links, photos open full-size); the script below adds instant filtering + the lightbox.
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroMist from '../components/HeroMist.astro';
import DarkCta from '../components/DarkCta.astro';
import { getVisibleGalleryImages } from '../lib/gallery-db';
import { cachePublic } from '../lib/cache';

export const prerender = false;
cachePublic(Astro);

const images = await getVisibleGalleryImages();
const tags = [...new Set(images.map((i) => i.tag).filter(Boolean))];
const requested = Astro.url.searchParams.get('tag') ?? '';
const active = tags.includes(requested) ? requested : '';
const heroImage = '/assets/images/image/dochula 3.webp';
---

<SiteLayout
  title="Gallery — Altara"
  description="A look at Bhutan through our lens — dzongs, festivals, high passes, valleys and the people we travel with."
  image={images[0]?.image_url ?? heroImage}
>
  <section class="hero hero--page hero--center" style={`background-image:url('${heroImage}');background-position:center 40%;`}>
    <div class="hero-content">
      <h1>Gallery</h1>
    </div>
    <HeroMist />
  </section>

  <section class="tour-section gallery-section" data-gallery>
    <div class="container">
      <div class="tour-head">
        <h2>Bhutan, Through Our Lens</h2>
        <p>Dzongs, festivals, high passes and quiet valleys — moments from the journeys we shape.</p>
      </div>

      {
        tags.length > 1 && (
          <nav class="tour-chips gallery-filters" aria-label="Filter photos">
            <a href="/gallery" data-tag="" class:list={['tour-chip', { 'is-active': !active }]} aria-pressed={!active}>
              All<span>{images.length}</span>
            </a>
            {tags.map((t) => (
              <a href={`/gallery?tag=${encodeURIComponent(t)}`} data-tag={t} class:list={['tour-chip', { 'is-active': active === t }]} aria-pressed={active === t}>
                {t}
                <span>{images.filter((i) => i.tag === t).length}</span>
              </a>
            ))}
          </nav>
        )
      }

      {
        images.length === 0 ? (
          <p class="tour-note">New photographs are on their way.</p>
        ) : (
          <div class="gallery-masonry">
            {images.map((img) => (
              <a
                href={img.image_url}
                class="gallery-item"
                data-tag={img.tag}
                data-alt={img.alt}
                hidden={Boolean(active) && img.tag !== active}
                target="_blank"
                rel="noopener"
              >
                <img src={img.image_url} alt={img.alt} loading="lazy" decoding="async" />
                <span class="gallery-cap">{img.alt}</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <dialog class="gallery-lightbox" data-lightbox aria-label="Photo viewer">
    <button type="button" class="gl-btn gl-close" data-gl="close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <button type="button" class="gl-btn gl-prev" data-gl="prev" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button type="button" class="gl-btn gl-next" data-gl="next" aria-label="Next photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
    <figure>
      <img src="" alt="" data-gl-img />
      <figcaption data-gl-cap></figcaption>
    </figure>
  </dialog>

  <DarkCta image="/assets/images/image/bumthang view1.webp" />
</SiteLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  const box = document.querySelector<HTMLElement>('[data-lightbox]') as unknown as {
    showModal(): void;
    close(): void;
    open: boolean;
    addEventListener: HTMLElement['addEventListener'];
    querySelector: HTMLElement['querySelector'];
  } | null;

  if (root && box) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.gallery-item'));
    const chips = Array.from(root.querySelectorAll<HTMLElement>('[data-tag].tour-chip'));
    const img = box.querySelector('[data-gl-img]') as HTMLImageElement;
    const cap = box.querySelector('[data-gl-cap]') as HTMLElement;
    let visible: HTMLElement[] = items;
    let at = 0;

    // Instant filter by group
    function filter(tag: string) {
      items.forEach((it) => (it.hidden = Boolean(tag) && it.dataset.tag !== tag));
      visible = items.filter((it) => !it.hidden);
      chips.forEach((c) => {
        const on = (c.dataset.tag ?? '') === tag;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });
      history.replaceState(null, '', tag ? `?tag=${encodeURIComponent(tag)}` : location.pathname);
    }
    chips.forEach((c) =>
      c.addEventListener('click', (e) => {
        e.preventDefault();
        filter(c.dataset.tag ?? '');
      }),
    );
    visible = items.filter((it) => !it.hidden);

    // Lightbox
    function show(i: number) {
      at = (i + visible.length) % visible.length;
      const it = visible[at];
      img.src = it.querySelector('img')?.src ?? '';
      img.alt = it.dataset.alt ?? '';
      cap.textContent = it.dataset.alt ?? '';
    }
    items.forEach((it) =>
      it.addEventListener('click', (e) => {
        e.preventDefault();
        show(visible.indexOf(it));
        box.showModal();
      }),
    );
    box.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const act = t.closest<HTMLElement>('[data-gl]')?.dataset.gl;
      if (act === 'next') show(at + 1);
      else if (act === 'prev') show(at - 1);
      else if (act === 'close' || t === (box as unknown as HTMLElement)) box.close(); // click on the backdrop closes
    });
    document.addEventListener('keydown', (e) => {
      if (!box.open) return;
      if (e.key === 'ArrowRight') show(at + 1);
      if (e.key === 'ArrowLeft') show(at - 1);
    });
  }
</script>
