---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import CategoryForm from '../../../../components/admin/CategoryForm.astro';
import { categoryPath, getCategoryById, updateCategory } from '../../../../lib/categories-db';
import { parseCategoryForm, valuesFromCategory } from '../../../../lib/category-form';
import type { FormErrors } from '../../../../lib/tour-form';

export const prerender = false;

const id = Number(Astro.params.id);
const category = Number.isInteger(id) && id > 0 ? await getCategoryById(id) : null;
if (!category) return Astro.rewrite('/404');

let values = valuesFromCategory(category);
let errors: FormErrors = {};
let failed = false;

if (Astro.request.method === 'POST') {
  const result = await parseCategoryForm(await Astro.request.formData(), category.id);
  values = result.values;
  errors = result.errors;
  if (result.input) {
    try {
      await updateCategory(category.id, category.slug, result.input);
      return Astro.redirect(`/admin/categories/${category.id}/edit?saved=1`);
    } catch (error) {
      console.error('[admin/categories/edit] save failed:', error);
      failed = true;
    }
  }
}

const saved = Astro.url.searchParams.get('saved');
---

<AdminLayout title={`Edit ${category.label}`}>
  <p><a href="/admin/categories" class="text-link">&larr; All categories</a></p>
  <div class="mt-3 mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-display text-3xl text-ink">Edit category</h1>
    <a href={categoryPath(category.slug)} target="_blank" rel="noopener" class="text-link">View on site</a>
  </div>
  {saved && <p role="status" class="mb-6 max-w-4xl border border-green-700 bg-green-50 p-3 text-sm font-semibold text-green-900">Saved.</p>}
  {failed && <p role="alert" class="mb-6 max-w-4xl border border-red-700 bg-red-50 p-3 text-sm text-red-800">Something went wrong and your changes were not saved. They are still below: please try again.</p>}
  <CategoryForm values={values} errors={errors} />
</AdminLayout>
