---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { categoryPath, countToursInCategory, deleteCategory, listCategories } from '../../../lib/categories-db';

export const prerender = false;

let notice = '';
let error = '';

// Delete is a POST handled here. A category with tours in it cannot be deleted.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  const slug = String(form.get('slug') ?? '');
  if (form.get('intent') === 'delete' && Number.isInteger(id) && id > 0) {
    try {
      if ((await countToursInCategory(slug)) > 0) {
        error = 'Move or delete the tours in that category first.';
      } else {
        await deleteCategory(id);
        return Astro.redirect('/admin/categories?deleted=1');
      }
    } catch (e) {
      console.error('[admin/categories] delete failed:', e);
      error = 'Something went wrong. Please try again.';
    }
  }
}
if (Astro.url.searchParams.get('deleted')) notice = 'Category deleted.';

const categories = await listCategories();
const counts = await Promise.all(categories.map((c) => countToursInCategory(c.slug)));
---

<AdminLayout title="Categories">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-display text-3xl text-ink">Tour categories</h1>
    <a href="/admin/categories/new" class="btn btn-solid">Add category</a>
  </div>
  <p class="mt-2 max-w-2xl text-sm text-muted">
    Each category gets its own listing page. Add tours to a category from the category tabs on the <a href="/admin/tours" class="text-link">Tours</a> page.
  </p>

  {notice && <p role="status" class="mt-5 border border-green-700 bg-green-50 p-3 text-sm text-green-900">{notice}</p>}
  {error && <p role="alert" class="mt-5 border border-red-700 bg-red-50 p-3 text-sm text-red-800">{error}</p>}

  <div class="mt-6 overflow-x-auto border border-line bg-white">
    <table class="w-full min-w-[40rem] text-left text-sm">
      <thead class="border-b border-line bg-offwhite text-xs uppercase tracking-wider text-muted">
        <tr>
          <th scope="col" class="px-4 py-3">Category</th>
          <th scope="col" class="px-4 py-3">Tours</th>
          <th scope="col" class="px-4 py-3">Page</th>
          <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line align-top">
        {
          categories.map((c, i) => (
            <tr>
              <td class="px-4 py-3">
                <a href={`/admin/categories/${c.id}/edit`} class="font-bold text-ink hover:text-accent-dark">{c.label}</a>
                <span class="block text-xs text-muted">{c.slug}</span>
              </td>
              <td class="px-4 py-3"><a href={`/admin/tours?category=${c.slug}`} class="text-link">{counts[i]}</a></td>
              <td class="px-4 py-3"><a href={categoryPath(c.slug)} target="_blank" rel="noopener" class="text-link">{categoryPath(c.slug)}</a></td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap items-start justify-end gap-x-4 gap-y-2">
                  <a href={`/admin/tours/new?category=${c.slug}`} class="text-link">Add tour</a>
                  <a href={`/admin/categories/${c.id}/edit`} class="text-link">Edit</a>
                  {counts[i] === 0 && (
                    <details class="relative">
                      <summary class="cursor-pointer list-none text-sm font-bold text-red-700 hover:underline [&::-webkit-details-marker]:hidden">Delete</summary>
                      <form method="post" class="absolute right-0 z-10 mt-2 w-60 border border-red-700 bg-white p-3 text-left shadow-lg">
                        <p class="text-xs text-body">Delete “{c.label}”? This cannot be undone.</p>
                        <input type="hidden" name="id" value={c.id} />
                        <input type="hidden" name="slug" value={c.slug} />
                        <button name="intent" value="delete" class="mt-3 w-full bg-red-700 px-3 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-red-800">Yes, delete</button>
                      </form>
                    </details>
                  )}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
