---
import AdminBase from '../../layouts/AdminBase.astro';
import { checkCredentials, clearFailures, createSession, hashIp, isLockedOut, recordFailure, setSessionCookie } from '../../lib/auth';

export const prerender = false;

const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');

  try {
    const ipHash = await hashIp(Astro.clientAddress || 'unknown');
    if (!EMAIL.test(email) || email.length > 200 || password.length < 1 || password.length > 200) {
      error = 'Enter your email and password.';
    } else if (await isLockedOut(email, ipHash)) {
      error = 'Too many failed attempts. Please wait 15 minutes and try again.';
    } else {
      const user = await checkCredentials(email, password);
      if (user) {
        await clearFailures(email);
        const { token, expires } = await createSession(user.id);
        setSessionCookie(Astro.cookies, token, expires);
        return Astro.redirect('/admin');
      }
      await recordFailure(email, ipHash);
      error = 'Invalid email or password.';
    }
  } catch (e) {
    console.error('[login] failed:', e);
    error = 'Something went wrong. Please try again.';
  }
}

const field =
  'mt-2 block w-full border border-line bg-white px-4 py-3 text-base text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40';
---

<AdminBase title="Sign in">
  <main class="flex min-h-screen items-center justify-center px-5 py-16">
    <div class="w-full max-w-sm border border-line bg-white p-8 shadow-sm">
      <p class="eyebrow mb-2">Altara</p>
      <h1 class="font-display text-2xl font-medium tracking-wide text-ink">Admin sign in</h1>

      {error && <p role="alert" class="mt-5 border border-red-700 bg-red-50 p-3 text-sm text-red-800">{error}</p>}

      <form method="post" class="mt-6 space-y-5">
        <div>
          <label for="email" class="block text-[12px] font-bold uppercase tracking-[0.16em] text-ink">Email</label>
          <input id="email" name="email" type="email" required maxlength="200" autocomplete="username" value={email} class={field} />
        </div>
        <div>
          <label for="password" class="block text-[12px] font-bold uppercase tracking-[0.16em] text-ink">Password</label>
          <input id="password" name="password" type="password" required maxlength="200" autocomplete="current-password" class={field} />
        </div>
        <button type="submit" class="btn btn-solid w-full">Sign in</button>
      </form>
    </div>
  </main>
</AdminBase>
