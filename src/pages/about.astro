---
import SiteLayout from '../layouts/SiteLayout.astro';
import DarkCta from '../components/DarkCta.astro';

export const prerender = true;
---

<SiteLayout title="About — Altara" description="Altara is a private-journey house built around the Kingdom of Bhutan. Meet the people and the philosophy behind every considered itinerary.">
<!-- ================= HERO ================= -->
  <section class="hero hero--about hero--page hero--center"
    style="background-image:url('/assets/images/image/punakha5.webp');background-position:center 38%;">
    <div class="hero-content">
      <h1>About</h1>
    </div>
    <div class="hero-mist" aria-hidden="true">
      <div class="hero-mist-layer hero-mist-layer--1" style="background-image:url('/assets/images/cloud.webp');"></div>
      <div class="hero-mist-layer hero-mist-layer--2" style="background-image:url('/assets/images/cloud.webp');"></div>
    </div>
  </section>

  <!-- ================= OUR STORY ================= -->
  <section class="about about--feature reveal" id="story">
    <div class="container">
      <div class="about-media">
        <div class="about-media-main">
          <img src="/assets/images/image/Mongar 100723 by Nantawat-22.webp"
            alt="A quiet Mongar hillside in eastern Bhutan">
        </div>
        <div class="about-media-accent">
          <img src="/assets/images/image/khoma2.webp" alt="Handwoven textile detail from Khoma, Bhutan">
        </div>
      </div>
      <div class="about-copy">
        <span class="eyebrow eyebrow--accent">Our Story</span>
        <h2>Founded On<br><span class="gold">A Simple Belief</span></h2>
        <p>Altara began in Thimphu with a small team who had spent years guiding travelers across Bhutan for other
          operators — and grew tired of watching remarkable journeys get flattened into fixed-departure packages.</p>
        <p>We started Altara to do the opposite: build each itinerary from scratch, around one traveler or family at a
          time, with the same guides, drivers, and homes we'd trust for our own. Fifteen years later, that's still the
          entire business — <em>no templates, no fixed groups, no script</em>.</p>
        <p>What began as a handful of trips a year has grown into a full journey house, but the promise hasn't changed:
          every trip is still built by hand, for the person taking it.</p>
      </div>
    </div>
  </section>

  <!-- ================= OUR APPROACH ================= -->
  <section class="about about--reverse about--feature reveal">
    <div class="container">
      <div class="about-media">
        <div class="about-media-main">
          <img src="/assets/images/image/Mongar 100723 by Nantawat-3.webp" alt="Village life in Mongar, eastern Bhutan">
          <p class="about-media-caption">Time Is<br>The Luxury</p>
        </div>
        <div class="about-media-accent">
          <img src="/assets/images/image/khoma3.webp" alt="A weaver's hands at work in Khoma, Bhutan">
        </div>
      </div>
      <div class="about-copy">
        <span class="eyebrow eyebrow--accent">Our Philosophy</span>
        <h2>Travel As<br><span class="gold">Transformation</span></h2>
        <p>Bhutan is not a destination to be checked off — it is a country that asks you to slow down. Altara was
          founded on the belief that <em>true luxury is time</em>: time to sit with a monastery bell echoing across a
          valley, time to walk beside a farmer without an agenda, time to simply be somewhere fully.</p>
        <p>Every itinerary we build is private, unhurried, and shaped around a single traveler or family. We work only
          with a small circle of guides, drivers, and homes we trust completely — so the plan disappears, and the place
          gets to do the rest.</p>
      </div>
    </div>
  </section>

  <!-- ================= VALUES ================= -->
  <section class="values-section reveal">
    <div class="container">
      <div class="values-head">
        <span class="eyebrow eyebrow--accent">What Guides Us</span>
        <h2>Three Things We<br><span class="gold">Never Compromise On</span></h2>
      </div>
      <div class="value-grid">
        <div class="value-card">
          <div class="value-number">01</div>
          <h3>Private &amp; Unhurried</h3>
          <p>Every itinerary is built around one traveler or family &mdash; never a coach, never a fixed departure, never
            someone else's schedule.</p>
        </div>
        <div class="value-card">
          <div class="value-number">02</div>
          <h3>Local &amp; Trusted</h3>
          <p>We work only with a small circle of guides, drivers, and homes across Bhutan that our own team has
            personally vetted.</p>
        </div>
        <div class="value-card">
          <div class="value-number">03</div>
          <h3>Considered In Every Detail</h3>
          <p>From the first enquiry to the final transfer, nothing is templated &mdash; each day is shaped around how you want
            to feel.</p>
        </div>
      </div>
    </div>
  </section>

  <DarkCta image="/assets/images/image/Lhuentse dzong.webp" />
</SiteLayout>
