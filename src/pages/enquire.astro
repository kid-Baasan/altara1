---
import SiteLayout from '../layouts/SiteLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';

export const prerender = false;
---

<SiteLayout title="Enquire Now — Altara" description="Start planning your private Bhutan journey — send us a few details, reach us directly, or find us on the map.">
<!-- ================= HERO ================= -->
  <section class="hero hero--page hero--center"
    style="background-image:url('/assets/images/image/Wangdue.webp');background-position:center 40%;">
    <div class="hero-content">
      <h1>Enquire Now</h1>
    </div>
    <div class="hero-mist" aria-hidden="true">
      <div class="hero-mist-layer hero-mist-layer--1" style="background-image:url('/assets/images/cloud.webp');"></div>
      <div class="hero-mist-layer hero-mist-layer--2" style="background-image:url('/assets/images/cloud.webp');"></div>
    </div>
  </section>

  <!-- ================= ENQUIRE: SPLIT INTRO ================= -->
  <section class="enquire-split reveal">
    <div class="container">
      <div class="enquire-split-grid">

        <div class="enquire-visual">
          <div class="enquire-visual-img" style="background-image:url('/assets/images/image/jakar.webp');"></div>
          <div class="enquire-planner-card">
            <div class="team-avatar"><span class="team-initials">NW</span></div>
            <div>
              <div class="enquire-planner-name">Namgyel Wangchuk</div>
              <span class="enquire-planner-role">Usually The First Voice You'll Hear</span>
            </div>
          </div>
        </div>

        <div class="enquire-form-card">
          <span class="eyebrow eyebrow--accent">Tell Us A Little</span>
          <h2>Begin Your<br>Bhutan Story</h2>
          <p class="enquire-form-lede">The more you share, the more precisely we can design — every enquiry is read
            personally, and we reply within one business day.</p>
          <EnquiryForm idPrefix="enquire" />
          <p class="enquire-trade-link">Travel agent, hotel or local specialist? <a href="/partners">Partner with us</a>.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ================= ENQUIRE: REACH US DIRECTLY ================= -->
  <section class="contact-band reveal">
    <div class="container">
      <div class="contact-band-head">
        <span class="eyebrow eyebrow--accent">However You'd Prefer</span>
        <h2>Reach Us Directly</h2>
      </div>
      <div class="contact-icon-grid">
        <div class="contact-icon-card">
          <div class="contact-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
              stroke-linejoin="round">
              <path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 20l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          </div>
          <span class="contact-icon-label">WhatsApp</span>
          <a href="https://wa.me/9752333456" class="contact-icon-value" target="_blank" rel="noopener">+975 2 333
            456</a>
        </div>
        <div class="contact-icon-card">
          <div class="contact-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
              stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="M3 7l9 6 9-6" />
            </svg>
          </div>
          <span class="contact-icon-label">Email</span>
          <a href="mailto:hello@altara.travel" class="contact-icon-value">hello@altara.travel</a>
        </div>
        <div class="contact-icon-card">
          <div class="contact-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <span class="contact-icon-label">Office</span>
          <span class="contact-icon-value">Thimphu, Bhutan</span>
        </div>
        <div class="contact-icon-card">
          <div class="contact-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
              stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 3" />
            </svg>
          </div>
          <span class="contact-icon-label">Office Hours</span>
          <span class="contact-icon-value">Mon–Fri, 9am–5pm BTT</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ENQUIRE: MAP ================= -->
  <section class="enquire-map-section reveal">
    <div class="container">
      <div class="enquire-map-head">
        <span class="eyebrow eyebrow--accent">Find Us</span>
        <h2>Based In Thimphu</h2>
      </div>
      <div class="enquire-map">
        <iframe src="https://www.google.com/maps?q=Thimphu,Bhutan&output=embed" title="Altara office — Thimphu, Bhutan"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="enquire-map-caption">Altara is based in Thimphu, Bhutan — every itinerary is designed and run
        locally, start to finish.</p>
    </div>
  </section>
</SiteLayout>
