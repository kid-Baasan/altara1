---
import SiteLayout from '../layouts/SiteLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import PartnerForm from '../components/PartnerForm.astro';
import FormSelects from '../components/FormSelects.astro';
import { actions } from 'astro:actions';

export const prerender = false;

// Open on the trade tab after a trade submission, or when linked as /enquire?type=trade.
const tradeFirst = !!Astro.getActionResult(actions.submitPartnerInquiry) || Astro.url.searchParams.get('type') === 'trade';
---

<SiteLayout title="Enquire Now — Altara" description="Start planning your private Bhutan journey, or send a partnership proposal as a travel agent, hotel or local specialist. Every message is read personally.">
<!-- ================= HERO ================= -->
  <section class="hero hero--page hero--center"
    style="background-image:url('/assets/images/image/Wangdue.webp');background-position:center 40%;">
    <div class="hero-content">
      <h1>Enquire Now</h1>
    </div>
    <div class="hero-mist" aria-hidden="true">
      <div class="hero-mist-layer hero-mist-layer--1" style="background-image:url('/assets/images/cloud.webp');"></div>
      <div class="hero-mist-layer hero-mist-layer--2" style="background-image:url('/assets/images/cloud.webp');"></div>
    </div>
  </section>

  <!-- ================= ENQUIRE: DESK ================= -->
  <section class="desk reveal">
    <div class="container">
      <div class="desk-grid">

        <aside class="desk-side">
          <span class="eyebrow eyebrow--light">Private Journeys, By Hand</span>
          <h2>Begin Your<br><span class="gold">Bhutan Story</span></h2>
          <p class="desk-side-lede">Every message is read by a person in Thimphu — never a bot, never a sales queue.</p>

          <ul class="desk-promises">
            <li><strong>Within one business day</strong><span>Our reply time for every traveler enquiry.</span></li>
            <li><strong>No obligation</strong><span>A first proposal costs nothing and commits you to nothing.</span></li>
            <li><strong>Designed locally</strong><span>Planned and run by our own team, start to finish.</span></li>
          </ul>

          <div class="desk-planner">
            <div class="team-avatar"><span class="team-initials">NW</span></div>
            <div>
              <div class="enquire-planner-name">Namgyel Wangchuk</div>
              <span class="enquire-planner-role">Usually The First Voice You'll Hear</span>
            </div>
          </div>

          <ul class="desk-contact">
            <li>
              <span class="desk-contact-label">WhatsApp</span>
              <a href="https://wa.me/9752333456" target="_blank" rel="noopener">+975 2 333 456</a>
            </li>
            <li>
              <span class="desk-contact-label">Email</span>
              <a href="mailto:hello@altara.travel">hello@altara.travel</a>
            </li>
            <li>
              <span class="desk-contact-label">Office</span>
              <span>Thimphu, Bhutan &middot; Mon–Fri, 9am–5pm BTT</span>
            </li>
          </ul>
        </aside>

        <div class="desk-card">
          <input type="radio" name="desk-tab" id="desk-tab-trip" class="desk-radio" checked={!tradeFirst} />
          <input type="radio" name="desk-tab" id="desk-tab-trade" class="desk-radio" checked={tradeFirst} />

          <div class="desk-tabs" role="group" aria-label="Type of enquiry">
            <label for="desk-tab-trip"><span>For Travelers</span><small>Plan a journey</small></label>
            <label for="desk-tab-trade"><span>For The Trade</span><small>Agents, hotels &amp; partners</small></label>
          </div>

          <div class="desk-panel desk-panel--trip">
            <p class="enquire-form-lede">The more you share, the more precisely we can design. Tell us when, who with and what
              you're hoping to feel.</p>
            <EnquiryForm idPrefix="enquire" />
          </div>

          <div class="desk-panel desk-panel--trade">
            <p class="enquire-form-lede">Travel agent, tour operator, hotel or local specialist? Send us a proposal — our
              partnerships team replies within three business days. <a href="/partners">About partnering with Altara</a>.</p>
            <PartnerForm />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ================= ENQUIRE: MAP ================= -->
  <section class="enquire-map-section reveal">
    <div class="container">
      <div class="enquire-map-head">
        <span class="eyebrow eyebrow--accent">Find Us</span>
        <h2>Based In <span class="gold">Thimphu</span></h2>
      </div>
      <div class="enquire-map">
        <iframe src="https://www.google.com/maps?q=Thimphu,Bhutan&output=embed" title="Altara office — Thimphu, Bhutan"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p class="enquire-map-caption">Altara is based in Thimphu, Bhutan — every itinerary is designed and run
        locally, start to finish.</p>
    </div>
  </section>
  <FormSelects />
</SiteLayout>
